# ─────────────────────────────────────────────────────────────
# ZIPUP AI 환경 변수 예시
# 로컬: 이 파일을 .env.local 로 복사해서 값을 채우세요.
# Vercel: Project → Settings → Environment Variables 에 같은 이름으로 넣으세요.
# ─────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────
# Supabase → Project Settings → Database → Connection string
# 앱은 Transaction pooler(포트 6543) 주소를 쓰세요.
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 마이그레이션(pnpm db:migrate)용: Session pooler(포트 5432) 또는 Direct 주소
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 로그인 세션 암호화 키: `openssl rand -base64 32` 로 만든 값
BETTER_AUTH_SECRET=
# 사이트 주소 (끝에 / 없이). 웹훅·로그인 콜백에 쓰여요.
APP_URL=https://ai.creationzipup.com

# 처음부터 관리자로 만들 이메일 (쉼표로 여러 개). 비워 두면 "첫 번째 가입자"가 관리자가 돼요.
ADMIN_EMAILS=

# Vercel Cron 인증 (아무 긴 임의 문자열)
CRON_SECRET=

# ── 생성 API ──────────────────────────────────────────────────
# Higgsfield: https://console.higgsfield.ai 에서 API 키 발급  (형식: KEY_ID:KEY_SECRET)
# GPT Image 2.5 / GPT Image 2.0 / MiniMax H3 / Seedance 2.5
HF_CREDENTIALS=
# fal.ai: https://fal.ai/dashboard/keys
# Seedream 5.0 Pro / Nano Banana Pro / Nano Banana 2
FAL_KEY=

# 키 없이 화면만 둘러보거나 테스트할 때 1 (실제 API를 부르지 않고 가짜 결과를 만들어요)
MOCK_GENERATION=

# ── 스토리지 (Cloudflare R2, 운영 필수) ───────────────────────
# R2 → Manage R2 API Tokens → Object Read & Write
S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=zipup-ai
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 선택 ─────────────────────────────────────────────────────
# Google 계정으로 로그인 (Google Cloud Console → OAuth 클라이언트)
# 승인된 리디렉션 URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 다른 도메인에서도 로그인 요청을 받을 때 (쉼표 구분)
TRUSTED_ORIGINS=
