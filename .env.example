# ─────────────────────────────────────────────────────────────
# ZIPUP AI 환경 변수 예시
# 로컬: 이 파일을 .env.local 로 복사해서 값을 채우세요.
# Vercel: Project → Settings → Environment Variables 에 같은 이름으로 넣으세요.
# ─────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────
# Supabase → 상단 Connect → Connection string
# 앱은 Transaction pooler(포트 6543) 주소를 쓰세요.
# (Vercel의 Supabase 연동을 쓰면 POSTGRES_URL / POSTGRES_URL_NON_POOLING 이 자동으로 들어가고, 앱이 그 값을 읽어요)
DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 마이그레이션(pnpm db:migrate)용: Session pooler(포트 5432) 또는 Direct 주소
DIRECT_DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 파일 저장소 (Supabase Storage) — Project Settings → API Keys
SUPABASE_URL=https://xxxxxxxx.supabase.co
# service_role 키 또는 새 형식 secret 키(sb_secret_…). 서버에서만 쓰는 비밀 값이에요.
SUPABASE_SERVICE_ROLE_KEY=
# 버킷 이름 (없으면 처음 업로드할 때 비공개로 자동 생성)
SUPABASE_BUCKET=zipup-ai

# 로그인 세션 암호화 키: `openssl rand -base64 32` 로 만든 값
BETTER_AUTH_SECRET=
# 사이트 주소 (끝에 / 없이). 웹훅·로그인 콜백에 쓰여요. Vercel에서는 비워 두면 운영 주소를 자동으로 써요.
APP_URL=

# 처음부터 관리자로 만들 이메일 (쉼표로 여러 개). 비워 두면 "첫 번째 가입자"가 관리자가 돼요.
ADMIN_EMAILS=

# Vercel Cron 인증 (아무 긴 임의 문자열)
CRON_SECRET=

# ── 생성 API ──────────────────────────────────────────────────
# fal.ai: https://fal.ai/dashboard/keys  (형식: KEY_ID:KEY_SECRET, 잔액 충전 필요)
# 모든 모델을 fal.ai로도 돌릴 수 있어요. Seedance 2.5 공식 드래프트(→1080p 완성)는 fal.ai에서 동작해요.
# 번역·단어 추천 LLM도 이 키로 호출해요 (아래 LLM_* 를 따로 안 넣으면).
FAL_KEY=
# Higgsfield: https://console.higgsfield.ai 에서 발급 — "키 ID"와 "Secret" 두 값을 콜론으로 이어서
# (GPT Image 2.5 / GPT Image 2.0 / MiniMax H3 는 Higgsfield 우선, 키가 없으면 fal.ai로 자동 전환)
HF_CREDENTIALS=

# 키 없이 화면만 둘러보거나 테스트할 때 1 (실제 API를 부르지 않고 가짜 결과를 만들어요)
MOCK_GENERATION=

# ── 스토리지 대안: Cloudflare R2 (선택) ─────────────────────────
# 값을 넣으면 Supabase Storage 대신 R2를 써요. R2 → Manage R2 API Tokens → Object Read & Write
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── 번역·단어 추천 LLM (선택) ─────────────────────────────────
# 비워 두면 FAL_KEY로 fal.ai OpenRouter 라우터를 써요 (기본 모델: Gemini 2.5 Flash-Lite, 호출당 $0.001 미만).
# 무료로 쓰려면 Google AI Studio(https://aistudio.google.com/apikey)의 무료 키를 넣으세요:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_API_KEY=발급받은키
#   LLM_MODEL=gemini-2.5-flash-lite
# OpenRouter 무료 모델도 가능: LLM_BASE_URL=https://openrouter.ai/api/v1, LLM_MODEL=qwen/qwen3.8-27b:free
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# auto(기본) | fal | openai | mock(모의, 화면 테스트용) | off
LLM_PROVIDER=

# ── 선택 ─────────────────────────────────────────────────────
# Google 계정으로 로그인 (Google Cloud Console → OAuth 클라이언트)
# 승인된 리디렉션 URI: {APP_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 다른 도메인에서도 로그인 요청을 받을 때 (쉼표 구분)
TRUSTED_ORIGINS=
